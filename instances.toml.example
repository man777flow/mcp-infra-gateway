# Copy this file to instances.toml and fill in your real servers + API keys:
#   cp instances.toml.example instances.toml
#
# instances.toml is gitignored — real URLs and tokens never get committed.
# Each [[zabbix]] / [[grafana]] / [[nautobot]] block is one instance: its own
# server, its own API key, its own container, its own port. Add as many of
# each as you need — one org, multiple clients, staging + prod, whatever.
#
# After editing, run `make install` (first time) or `make deploy` (after
# changes) — nothing here is prompted for interactively.

# --- Zabbix -------------------------------------------------------------
# `port` is the MCP endpoint; `admin_port` is that instance's admin portal
# (manage the Zabbix connection/tokens without editing files — set its
# password on first visit, see types/zabbix/README.md).

[[zabbix]]
name = "prod"                      # used in the registered MCP server name: zabbix-prod
url = "https://zabbix.example.com"
api_token = "paste-your-zabbix-api-token-here"
port = 8001
admin_port = 9001
read_only = false                  # true blocks all write operations
verify_ssl = true

# [[zabbix]]
# name = "client-a"
# url = "https://zabbix.client-a.example.com"
# api_token = "paste-token-here"
# port = 8011
# admin_port = 9011
# read_only = true
# verify_ssl = true

# --- Grafana --------------------------------------------------------------

[[grafana]]
name = "prod"                      # -> grafana-prod
url = "https://grafana.example.com"
api_token = "paste-your-grafana-service-account-token-here"
port = 8101

# [[grafana]]
# name = "client-a"
# url = "https://grafana.client-a.example.com"
# api_token = "paste-token-here"
# port = 8111

# --- Nautobot ---------------------------------------------------------------

[[nautobot]]
name = "prod"                      # -> nautobot-prod
url = "https://nautobot.example.com/"
api_token = "paste-your-nautobot-api-token-here"
port = 8201
github_token = ""                  # optional, only for knowledge-base search

# [[nautobot]]
# name = "client-a"
# url = "https://nautobot.client-a.example.com/"
# api_token = "paste-token-here"
# port = 8211
# github_token = ""
