#
# Zabbix MCP Server Configuration — generated by scripts/generate.py from
# this template for instance "{{NAME}}". Don't edit by hand; edit
# instances.toml and re-run `make generate` (or `make deploy`) instead.
#

[server]
transport = "http"
host = "0.0.0.0"
port = 8080
log_level = "info"
compact_output = true
rate_limit = 300

[admin]
enabled = true
port = 9090

# No admin user is pre-seeded here — log in to this instance's admin portal
# on first access to set a password (Administration -> Users on first visit),
# or set [admin.users.admin] manually. See types/zabbix/README.md.

[zabbix.{{NAME}}]
url = "{{URL}}"
api_token = "{{API_TOKEN}}"
read_only = {{READ_ONLY}}
verify_ssl = {{VERIFY_SSL}}
